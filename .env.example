# Redis Streams Event Bus
MADE_REDIS_HOST=localhost
MADE_REDIS_PORT=6379
MADE_REDIS_USERNAME=
MADE_REDIS_PASSWORD=
MADE_REDIS_DB=0

# PostgreSQL Persistence
MADE_POSTGRES_HOST=localhost
MADE_POSTGRES_PORT=5432
MADE_POSTGRES_DATABASE=made_db
MADE_POSTGRES_USERNAME=made_user
MADE_POSTGRES_PASSWORD=made_password

# Stream Configuration
MADE_INPUT_STREAM=events:normalized
MADE_CONSUMER_GROUP=made-core-processors
MADE_CONSUMER_NAME=worker-1
MADE_DEAD_LETTER_STREAM=events:dead-letter

# Worker & Snapshot Cache
MADE_SNAPSHOT_FRESHNESS_TTL_SECONDS=120.0

# Telegram Notifications
MADE_TELEGRAM_BOT_TOKEN=
MADE_TELEGRAM_CHAT_ID=
MADE_TELEGRAM_API_BASE_URL=https://api.telegram.org
MADE_TELEGRAM_TIMEOUT_SECONDS=10.0
MADE_TELEGRAM_MAX_RETRIES=3
MADE_TELEGRAM_RETRY_BASE_DELAY_SECONDS=1.0

# Telegram Forum / Topics routing (message_thread_id)
MADE_TELEGRAM_TOPIC_FUTURES_FUTURES=
MADE_TELEGRAM_TOPIC_SPOT_FUTURES=
MADE_TELEGRAM_TOPIC_DEX_FUTURES=
MADE_TELEGRAM_TOPIC_FUNDING=
MADE_TELEGRAM_TOPIC_GENERAL=

# FastAPI REST API Service
MADE_API_HOST=0.0.0.0
MADE_API_PORT=8000
MADE_API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Web Dashboard
VITE_API_BASE_URL=http://localhost:8000

# Anomaly Detection Thresholds
MADE_PRICE_SPREAD_THRESHOLD_PERCENT=4.0
MADE_FUNDING_SPREAD_THRESHOLD=0.0005

